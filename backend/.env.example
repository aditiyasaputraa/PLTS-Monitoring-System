# Runtime and CORS
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
SCRAPE_INTERVAL_SECONDS=300
SCRAPE_REQUEST_TIMEOUT=30
SCRAPE_REQUEST_DELAY=0.15
AUTO_SCRAPE=true
SCRAPE_ON_STARTUP=true
ENABLE_HUAWEI=true
ENABLE_KEHUA=true
REFRESH_SECRET=replace-with-a-long-random-scheduler-secret

# Supabase server-side storage. Never expose SUPABASE_SECRET_KEY to the frontend.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Must be sb_secret_... or a legacy service_role JWT; never use sb_publishable_.../anon.
SUPABASE_SECRET_KEY=replace-with-supabase-secret-or-service-role-key
SUPABASE_CURRENT_TABLE=monitoring_current
SUPABASE_HISTORY_TABLE=monitoring_snapshots
SUPABASE_DAILY_TABLE=monitoring_site_daily
HISTORY_INTERVAL_SECONDS=3600
HISTORY_RETENTION_DAYS=30

# ==============================================================================
# CARA MENAMBAH AKUN VENDOR BARU (HUAWEI, KEHUA, ATAU SMA):
# ==============================================================================
# Anda dapat menambahkan akun baru dengan 2 cara:
#
# CARA 1 (Paling Mudah):
# Cukup tambahkan USERNAME_{nomor} dan PASSWORD_{nomor} (dan opsi REGION_{nomor}).
# Contoh jika ingin menambah akun Huawei ke-8:
#   HUAWEI_USERNAME_8=username_anda
#   HUAWEI_PASSWORD_8=password_anda
#   HUAWEI_REGION_8=Jakarta Timur  (opsional, pilih: Jakarta Pusat / Barat / Selatan / Timur / Utara)
#
# CARA 2 (JSON Array):
# Masukkan daftar akun ke HUAWEI_ACCOUNTS_JSON, KEHUA_ACCOUNTS_JSON, atau SMA_ACCOUNTS_JSON.
# Contoh:
#   HUAWEI_ACCOUNTS_JSON=[{"username":"user8","password":"pass8","region":"Jakarta Timur"}]
#
# Di GitHub Actions:
# Workflow (.github/workflows/scraper.yml) sudah otomatis terhubung hingga akun ke-20
# untuk masing-masing vendor. Anda hanya perlu membuat New Repository Secret di GitHub
# dengan nama yang sama (misal HUAWEI_USERNAME_8 & HUAWEI_PASSWORD_8).
# ==============================================================================

# Huawei FusionSolar Accounts (1 - 20)
HUAWEI_USERNAME=replace-me
HUAWEI_PASSWORD=replace-me
# HUAWEI_REGION="Jakarta Utara"
# HUAWEI_USERNAME_2=replace-me
# HUAWEI_PASSWORD_2=replace-me
# HUAWEI_REGION_2="Jakarta Barat"
# HUAWEI_USERNAME_3=replace-me
# HUAWEI_PASSWORD_3=replace-me
# HUAWEI_REGION_3="Jakarta Barat"
# HUAWEI_USERNAME_4=replace-me
# HUAWEI_PASSWORD_4=replace-me
# HUAWEI_REGION_4="Jakarta Pusat"
# HUAWEI_USERNAME_5=replace-me
# HUAWEI_PASSWORD_5=replace-me
# HUAWEI_REGION_5="Jakarta Selatan"
# HUAWEI_USERNAME_6=replace-me
# HUAWEI_PASSWORD_6=replace-me
# HUAWEI_REGION_6="Jakarta Selatan"
# HUAWEI_USERNAME_7=replace-me
# HUAWEI_PASSWORD_7=replace-me
# HUAWEI_REGION_7="Jakarta Timur"
# Tambah akun berikutnya jika ada:
# HUAWEI_USERNAME_8=replace-me
# HUAWEI_PASSWORD_8=replace-me
# HUAWEI_REGION_8="Jakarta Timur"
# Opsi JSON array:
# HUAWEI_ACCOUNTS_JSON=[]

# Kehua Tech Accounts (1 - 20)
KEHUA_USERNAME=replace-me
KEHUA_PASSWORD=replace-me
# KEHUA_REGION="Jakarta Utara"
# KEHUA_USERNAME_2=replace-me
# KEHUA_PASSWORD_2=replace-me
# KEHUA_REGION_2="Jakarta Utara"
# KEHUA_USERNAME_3=replace-me
# KEHUA_PASSWORD_3=replace-me
# KEHUA_REGION_3="Jakarta Barat"
# KEHUA_USERNAME_4=replace-me
# KEHUA_PASSWORD_4=replace-me
# KEHUA_REGION_4="Jakarta Barat"
# KEHUA_USERNAME_5=replace-me
# KEHUA_PASSWORD_5=replace-me
# KEHUA_REGION_5="Jakarta Pusat"
# KEHUA_USERNAME_6=replace-me
# KEHUA_PASSWORD_6=replace-me
# KEHUA_REGION_6="Jakarta Pusat"
# KEHUA_USERNAME_7=replace-me
# KEHUA_PASSWORD_7=replace-me
# KEHUA_REGION_7="Jakarta Selatan"
# KEHUA_USERNAME_8=replace-me
# KEHUA_PASSWORD_8=replace-me
# KEHUA_REGION_8="Jakarta Selatan"
# Tambah akun berikutnya jika ada:
# KEHUA_USERNAME_9=replace-me
# KEHUA_PASSWORD_9=replace-me
# KEHUA_REGION_9="Jakarta Timur"
# Opsi JSON array:
# KEHUA_ACCOUNTS_JSON=[]

# SMA Sunny Portal (ennexOS) Accounts (1 - 20)
ENABLE_SMA=true
SMA_USERNAME=replace-me
SMA_PASSWORD=replace-me
# SMA_REGION="Jakarta Timur"
# SMA_USERNAME_2=replace-me
# SMA_PASSWORD_2=replace-me
# SMA_REGION_2="Jakarta Barat"
# SMA_USERNAME_3=replace-me
# SMA_PASSWORD_3=replace-me
# SMA_REGION_3="Jakarta Pusat"
# SMA_USERNAME_4=replace-me
# SMA_PASSWORD_4=replace-me
# SMA_REGION_4="Jakarta Selatan"
# Tambah akun berikutnya jika ada:
# SMA_USERNAME_5=replace-me
# SMA_PASSWORD_5=replace-me
# SMA_REGION_5="Jakarta Utara"
# Opsi JSON array:
# SMA_ACCOUNTS_JSON=[]

# Paste each complete JSON cookie export on one line in GitHub Secrets or .env (opsional jika login otomatis).
HUAWEI_COOKIES_JSON=[]
KEHUA_COOKIES_JSON=[]
SMA_COOKIES_JSON=[]

# OneSignal Push Notifications (Mobile)
ONESIGNAL_APP_ID=4dfb6c2d-99e0-4f50-aef6-847a8331303b
ONESIGNAL_REST_API_KEY=replace-with-onesignal-rest-api-key
